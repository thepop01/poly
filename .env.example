# Database & Redis Configuration
DATABASE_URL=postgresql://poly_user:your_secure_password_here@localhost:5432/poly_db
REDIS_PASSWORD=your_redis_password_here

# JWT Authentication
JWT_SECRET=your_32_character_jwt_secret_key_here

# External APIs
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
POLYGONSCAN_API_KEY_1=your_polygonscan_api_key_1_here
POLYGONSCAN_API_KEY_2=your_polygonscan_api_key_2_here
POLYGONSCAN_API_KEY_3=your_polygonscan_api_key_3_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
ENVIO_API_KEY=your_envio_api_key_here
ENVIO_API_TOKEN=your_envio_api_token_here
ENVIO_HYPERSYNC_URL=https://polygon.hypersync.xyz
DUNE_API_KEY=your_dune_api_key_here

# CORS & Server Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Research Hub
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible gateway (e.g. a local proxy).
# Leave empty to use api.openai.com.
OPENAI_BASE_URL=
# Provider adapter: "responses" (OpenAI Responses API) or "chat-completions".
# Use "chat-completions" for third-party gateways whose /v1/responses
# translation is lossy.
RESEARCH_PROVIDER=responses
RESEARCH_MODEL=gpt-5-mini
RESEARCH_MAX_TOOL_CALLS=6
RESEARCH_MAX_ROWS=1000
RESEARCH_RUN_TIMEOUT_SECONDS=90

