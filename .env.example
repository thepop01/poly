# ==========================================
# Polymarket Analytics Platform
# Environment Configuration Example
# 
# Copy this file to .env and fill in your values
# ==========================================

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgres://poly_user:poly_password@localhost:5432/poly_db

# ==========================================
# Polymarket API Configuration
# ==========================================
# Gamma API - Market data and metadata
GAMMA_API_URL=https://gamma-api.polymarket.com

# Data API - Wallet activity and positions
DATA_API_URL=https://data-api.polymarket.com

# CLOB WebSocket - Real-time price and trade updates
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ==========================================
# Worker Configuration (polling intervals in seconds)
# ==========================================
# How often to poll Gamma API for new markets
GAMMA_POLL_INTERVAL_SECONDS=60

# Max events to fetch per Gamma API call
GAMMA_EVENTS_LIMIT=100

# How often to poll Data API for wallet activity
DATA_POLL_INTERVAL_SECONDS=60

# How often to fetch sports fixtures and stats
SPORTS_POLL_INTERVAL_SECONDS=3600

# ==========================================
# Sports API Configuration
# ==========================================
# API-Sports key for Football, Basketball, MMA, Tennis
# Get free tier at: https://api-sports.io
API_SPORTS_API_KEY=your_api_sports_key_here

# Sportmonks key for Cricket
# Get free tier at: https://sportmonks.com
SPORTMONKS_API_KEY=your_sportmonks_key_here

# ==========================================
# Bitquery Configuration (for whale detection)
# ==========================================
# Bitquery GraphQL for on-chain data
# Get free tier at: https://bitquery.io
BITQUERY_API_KEY=your_bitquery_key_here

# ==========================================
# Redis Configuration (for real-time alerts and pub/sub)
# ==========================================
# Redis connection string
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT Configuration (for authentication)
# ==========================================
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_jwt_secret_here_change_in_production

# JWT token expiration times
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# Frontend Configuration
# ==========================================
# Backend API URL (used by Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==========================================
# Environment Setting
# ==========================================
# Options: development, staging, production
ENVIRONMENT=development

# ==========================================
# Discord Integration
# ==========================================
# Used for OAuth login and Interactions (Alerts)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
